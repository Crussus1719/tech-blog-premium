---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await page.render();
---

<BaseLayout title={page.data.title}>
  <section class="py-20 px-4 md:px-8 max-w-3xl mx-auto prose prose-lg prose-stone">
    <Content />
  </section>
</BaseLayout>

<style is:global>
  .prose h1 { @apply text-4xl font-bold font-heading mb-8; }
  .prose h2 { @apply text-2xl font-bold font-heading mt-12 mb-6; }
  .prose p { @apply mb-6 text-gray-700 leading-relaxed; }
</style>
