---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fale Conosco" description="Entre em contato com nossa equipe para dúvidas, sugestões ou parcerias.">
	<section class="py-20 px-4 md:px-8 max-w-4xl mx-auto">
		<div class="text-center mb-16">
			<h1 class="text-4xl md:text-6xl font-bold font-heading mb-6">Fale Conosco</h1>
			<p class="text-lg text-gray-600 leading-relaxed">Tem alguma dúvida sobre tecnologia ou quer sugerir um tema? Estamos aqui para ouvir você.</p>
		</div>

		<div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-black/5">
			<div class="grid grid-cols-1 md:grid-cols-2">
				<div class="p-12 bg-[#C36E46] text-white">
					<h2 class="text-3xl font-bold font-heading mb-8">Informações</h2>
					<div class="space-y-6">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">📧</div>
							<div>
								<p class="font-bold">Email</p>
								<p class="text-white/80">contato@techpremium.com</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center">📍</div>
							<div>
								<p class="font-bold">Escritório</p>
								<p class="text-white/80">São Paulo, Brasil</p>
							</div>
						</div>
					</div>
					<div class="mt-20">
						<p class="text-sm text-white/60">Respondemos em até 24 horas úteis.</p>
					</div>
				</div>
				
				<div class="p-12">
					<form action="#" method="POST" class="space-y-6">
						<div>
							<label for="name" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wider">Nome Completo</label>
							<input type="text" id="name" name="name" class="w-full px-6 py-4 bg-[#F9F1DC]/30 border border-gray-100 rounded-2xl focus:border-[#C36E46] focus:ring-0 transition-all outline-none" placeholder="Ex: João Silva" required />
						</div>
						<div>
							<label for="email" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wider">E-mail</label>
							<input type="email" id="email" name="email" class="w-full px-6 py-4 bg-[#F9F1DC]/30 border border-gray-100 rounded-2xl focus:border-[#C36E46] focus:ring-0 transition-all outline-none" placeholder="Ex: joao@email.com" required />
						</div>
						<div>
							<label for="message" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wider">Mensagem</label>
							<textarea id="message" name="message" rows="4" class="w-full px-6 py-4 bg-[#F9F1DC]/30 border border-gray-100 rounded-2xl focus:border-[#C36E46] focus:ring-0 transition-all outline-none resize-none" placeholder="Como podemos ajudar?" required></textarea>
						</div>
						<button type="submit" class="w-full py-4 bg-[#C36E46] text-white rounded-full font-bold shadow-xl hover:shadow-[#C36E46]/30 hover:-translate-y-0.5 transition-all">Enviar Mensagem</button>
					</form>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
