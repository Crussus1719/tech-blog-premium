---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fale Conosco">
	<section class="py-20 px-4 md:px-8 max-w-4xl mx-auto">
		<div class="text-center mb-16">
			<h1 class="text-4xl md:text-6xl font-bold font-heading mb-6">Fale Conosco</h1>
		</div>
		<div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-black/5">
			<div class="grid grid-cols-1 md:grid-cols-2">
				<div class="p-12 bg-[#C36E46] text-white">
					<h2 class="text-3xl font-bold font-heading mb-8">Informações</h2>
					<p>contato@techpremium.com</p>
				</div>
				<div class="p-12">
					<form class="space-y-6">
						<input type="text" class="w-full px-6 py-4 bg-[#F9F1DC]/30 border border-gray-100 rounded-2xl" placeholder="Nome" />
						<input type="email" class="w-full px-6 py-4 bg-[#F9F1DC]/30 border border-gray-100 rounded-2xl" placeholder="E-mail" />
						<textarea class="w-full px-6 py-4 bg-[#F9F1DC]/30 border border-gray-100 rounded-2xl" placeholder="Mensagem"></textarea>
						<button class="w-full py-4 bg-[#C36E46] text-white rounded-full font-bold">Enviar</button>
					</form>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
