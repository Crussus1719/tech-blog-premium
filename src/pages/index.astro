---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Tecnologia Descomplicada para o seu Dia a Dia">
	<section class="py-20 px-4 md:px-8 bg-gradient-to-br from-[#F9F1DC] to-[#f5ebcf]">
		<div class="max-w-4xl mx-auto text-center">
			<span class="inline-block px-4 py-1 bg-[#C36E46]/10 text-[#C36E46] rounded-full text-sm font-bold uppercase tracking-widest mb-6">Explore o Futuro</span>
			<h1 class="text-5xl md:text-7xl font-bold font-heading mb-8 leading-tight">Tecnologia de um jeito <span class="text-[#C36E46]">simples e direto.</span></h1>
			<p class="text-xl text-gray-700 mb-10 max-w-2xl mx-auto leading-relaxed">Descubra guias, dicas e as últimas tendências do mundo tech sem complicações. Foco em utilidade e performance.</p>
			<a href="#artigos" class="inline-block px-10 py-4 bg-[#C36E46] text-white rounded-full text-lg font-bold shadow-2xl hover:shadow-[#C36E46]/40 hover:-translate-y-1 transition-all">Começar Leitura</a>
		</div>
	</section>

	<div class="max-w-7xl mx-auto px-4 py-8">
		<div class="w-full h-24 bg-gray-100 rounded-2xl flex items-center justify-center border-2 border-dashed border-gray-300 text-gray-400 text-sm italic">
			Espaço Publicitário (AdSense Topo)
		</div>
	</div>

	<section id="artigos" class="py-20 px-4 md:px-8 max-w-7xl mx-auto">
		<div class="flex justify-between items-end mb-12">
			<div>
				<h2 class="text-3xl font-bold font-heading mb-2">Artigos Recentes</h2>
				<div class="w-20 h-1.5 bg-[#C36E46] rounded-full"></div>
			</div>
			<div class="hidden md:block">
				<p class="text-gray-500 font-medium">{posts.length} artigos publicados</p>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
			{posts.map((post) => (
				<ArticleCard 
					title={post.data.title}
					excerpt={post.data.seo_description}
					image={post.data.image || "/assets/blog/placeholder.jpg"}
					slug={post.slug}
					date={post.data.date}
				/>
			))}
		</div>
	</section>
</BaseLayout>
