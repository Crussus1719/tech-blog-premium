---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('pt-BR', {
	day: '2-digit',
	month: 'long',
	year: 'numeric'
});
---

<BaseLayout 
  title={post.data.title} 
  description={post.data.seo_description}
  image={post.data.image}
>
  <article class="py-20 px-4 md:px-8 max-w-4xl mx-auto">
    <div class="mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="px-3 py-1 bg-[#C36E46]/10 text-[#C36E46] text-xs font-bold rounded-full uppercase">{post.data.category}</span>
        <span class="text-gray-400">•</span>
        <time class="text-sm font-medium text-gray-500 uppercase tracking-widest">{formattedDate}</time>
      </div>
      
      <h1 class="text-4xl md:text-6xl font-bold font-heading mb-8 leading-tight">{post.data.title}</h1>
      
      <div class="flex items-center justify-center gap-4 mb-12">
        <div class="w-10 h-10 rounded-full bg-[#C36E46] flex items-center justify-center text-white font-bold">VH</div>
        <div class="text-left">
          <p class="text-sm font-bold text-gray-900">{post.data.author}</p>
          <p class="text-xs text-gray-500">Especialista em Tecnologia</p>
        </div>
      </div>

      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {post.data.tags.map(tag => (
          <span class="px-4 py-1 bg-white border border-gray-100 rounded-full text-xs font-semibold text-gray-500">#{tag}</span>
        ))}
      </div>
    </div>

    {post.data.image && (
      <div class="aspect-video rounded-3xl overflow-hidden shadow-2xl mb-16 border border-black/5">
        <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" />
      </div>
    )}

    <div class="prose prose-lg prose-stone mx-auto max-w-none">
      <!-- Ad Space In-Post -->
      <div class="w-full h-24 bg-gray-50 rounded-2xl flex items-center justify-center border border-dashed border-gray-200 text-gray-400 text-xs italic mb-12">
        Anúncio AdSense (Meio do Artigo)
      </div>

      <Content />

      <!-- Ad Space Bottom Post -->
      <div class="mt-20 p-8 bg-[#F9F1DC]/30 rounded-3xl border border-[#C36E46]/10 text-center">
        <div class="w-full h-64 bg-white/50 rounded-2xl flex items-center justify-center border-2 border-dashed border-gray-200 text-gray-400 text-sm italic">
          Anúncio AdSense (Final do Post)
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose h1 { @apply text-4xl font-bold font-heading mb-8; }
  .prose h2 { @apply text-3xl font-bold font-heading mt-16 mb-8 text-gray-900; }
  .prose p { @apply mb-8 text-gray-700 leading-relaxed text-lg; }
  .prose ul { @apply list-disc pl-6 mb-8 space-y-4 text-gray-700; }
  .prose strong { @apply text-gray-900 font-bold; }
</style>
